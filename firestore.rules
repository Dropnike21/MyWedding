rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDefaultOwner() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != "anonymous"
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == "babaynike2013@gmail.com"
          || request.auth.token.email == "josephsixson@mcstayuman.edu.ph"
          || request.auth.token.email == "nungaygela@gmail.com"
        );
    }

    function isHumanOrganizer() {
      return isDefaultOwner()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider != "anonymous"
          && exists(/databases/$(database)/documents/organizers/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.active == true
        );
    }

    function role() {
      return isDefaultOwner()
        ? "owner"
        : get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isHumanOrganizer() && role() == "owner";
    }

    function isCoordinator() {
      return isHumanOrganizer() && role() == "coordinator";
    }

    function isFinance() {
      return isHumanOrganizer() && role() == "finance";
    }

    function canReadPlanning() {
      return isOwner() || isCoordinator() || isFinance();
    }

    function canOperate() {
      return isOwner() || isCoordinator();
    }

    function canFinance() {
      return isOwner() || isFinance();
    }

    match /organizers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public website only reads a tightly scoped date/venue projection.
    // No private budget, guest, personal or organizer records are exposed.
    match /publicWeddingDetails/current {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly([
          "date", "dateTentative", "venueName", "venueTentative", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "date", "dateTentative", "venueName", "venueTentative", "updatedAt"
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.dateTentative is bool
        && request.resource.data.venueName is string
        && request.resource.data.venueName.size() <= 120
        && request.resource.data.venueTentative is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }


    match /weddings/{weddingId} {
      allow read: if canReadPlanning();
      allow create, update: if isOwner();
      allow delete: if false;

      match /guests/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canOperate();
        allow delete: if false;
      }

      match /vendors/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if isOwner() || isCoordinator() || isFinance();
        allow delete: if false;
      }

      match /expenses/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if isOwner() || isCoordinator() || isFinance();
        allow delete: if false;
      }

      match /payments/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canFinance();
        allow delete: if false;
      }

      match /budgetCategories/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canFinance();
        allow delete: if false;
      }

      match /tasks/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canOperate();
        allow delete: if false;
      }

      match /timeline/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canOperate();
        allow delete: if false;
      }

      match /decisions/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canOperate();
        allow delete: if false;
      }

      match /team/{recordId} {
        allow read: if canReadPlanning();
        allow create, update: if canOperate();
        allow delete: if false;
      }

      match /audit/{recordId} {
        allow read: if isOwner();
        allow create: if isHumanOrganizer()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.role == role();
        allow update, delete: if false;
      }
    }

    // Invitation security, guest sessions, and wedding-day camera access remain
    // server-only and will be handled by trusted Cloud Functions later.
    match /invitationRegistry/{document=**} {
      allow read, write: if false;
    }
    match /invitationCodes/{document=**} {
      allow read, write: if false;
    }
    match /guestSessions/{document=**} {
      allow read, write: if false;
    }
    match /invitationAttemptLimits/{document=**} {
      allow read, write: if false;
    }
    match /pendingPhotoUploads/{document=**} {
      allow read, write: if false;
    }
    match /photoUploads/{document=**} {
      allow read, write: if false;
    }
    match /weddingSettings/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
